      "name": "create_new_record_in_incident_table_with_request_body",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "pm.test(\"Status code name has Created\", function () {\r",
              "    pm.response.to.have.status(\"Created\");\r",
              "});\r",
              "pm.test(\"Validate the value of short description key\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.result.short_description).to.eql(\"REST API MAY26 Session\");\r",
              "});\r",
              "pm.test(\"Validate response format is json\", function () {\r",
              "    var actual = pm.response.headers.get(\"Content-Type\");\r",
              "    pm.expect(actual).to.contains(\"json\");\r",
              "});\r",
              "var jsonData = pm.response.json();\r",
              "pm.collectionVariables.set(\"sysId\", jsonData.result.sys_id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
